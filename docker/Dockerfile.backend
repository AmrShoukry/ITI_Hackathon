FROM node:20-alpine
WORKDIR /app
COPY package.json ./
COPY apps/backend/package.json ./apps/backend/
RUN npm install
COPY apps/backend ./apps/backend
RUN npx prisma generate --schema=apps/backend/prisma/schema.prisma
RUN npm run build --workspace=apps/backend
EXPOSE 4000
CMD ["sh", "-c", "npx prisma migrate deploy --schema=apps/backend/prisma/schema.prisma && npx ts-node --project apps/backend/tsconfig.json apps/backend/prisma/seed.ts && npm run start:prod --workspace=apps/backend"]
