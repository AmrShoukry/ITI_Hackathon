datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  email              String              @unique
  phone              String
  passwordHash       String              @map("password_hash")
  roleId             Int                 @map("role_id")
  role               Role                @relation(fields: [roleId], references: [id])
  status             String              @default("Active")
  preferredLanguage  String              @default("en") @map("preferred_language")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  verifications      OwnerVerification[] @relation("OwnerVerifications")
  reviewedVerif      OwnerVerification[] @relation("ReviewedVerifications")
  listings           Listing[]           @relation("OwnerListings")
  bookings           Booking[]           @relation("RenterBookings")
  damageReportsOwner DamageReport[]      @relation("OwnerDamageReports")
  damageReportsRent  DamageReport[]      @relation("RenterDamageReports")
  reviewsSubmitted   Review[]            @relation("ReviewerReviews")
  reviewsReceived    Review[]            @relation("RevieweeReviews")
  adminSettings      AdminSetting[]
  auditLogs          AuditLog[]

  @@map("users")
}

model OwnerVerification {
  id             String    @id @default(uuid()) @db.Uuid
  ownerId        String    @map("owner_id") @db.Uuid
  owner          User      @relation("OwnerVerifications", fields: [ownerId], references: [id], onDelete: Cascade)
  nationalIdUrl  String    @map("national_id_url")
  status         String    @default("Pending")
  decisionReason String?   @map("decision_reason")
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewer       User?     @relation("ReviewedVerifications", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("owner_verifications")
}

model Category {
  id            Int       @id @default(autoincrement())
  nameEn        String    @unique @map("name_en")
  nameAr        String    @unique @map("name_ar")
  descriptionEn String?   @map("description_en")
  descriptionAr String?   @map("description_ar")
  createdAt     DateTime  @default(now()) @map("created_at")
  listings      Listing[]

  @@map("categories")
}

model Listing {
  id            String         @id @default(uuid()) @db.Uuid
  ownerId       String         @map("owner_id") @db.Uuid
  owner         User           @relation("OwnerListings", fields: [ownerId], references: [id], onDelete: Restrict)
  categoryId    Int            @map("category_id")
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title         String
  description   String
  condition     String
  dailyPrice    Decimal        @map("daily_price") @db.Decimal(10, 2)
  depositAmount Decimal        @map("deposit_amount") @db.Decimal(10, 2)
  status        String         @default("Pending Approval")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  photos        ListingPhoto[]
  availability  Availability[]
  bookings      Booking[]

  @@map("listings")
}

model ListingPhoto {
  id           String   @id @default(uuid()) @db.Uuid
  listingId    String   @map("listing_id") @db.Uuid
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  photoUrl     String   @map("photo_url")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("listing_photos")
}

model Availability {
  id          Int      @id @default(autoincrement())
  listingId   String   @map("listing_id") @db.Uuid
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  isBlocked   Boolean  @default(true) @map("is_blocked")
  description String?

  @@map("availability")
}

model Booking {
  id                 String         @id @default(uuid()) @db.Uuid
  renterId           String         @map("renter_id") @db.Uuid
  renter             User           @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Restrict)
  listingId          String         @map("listing_id") @db.Uuid
  listing            Listing        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  startDate          DateTime       @map("start_date") @db.Date
  endDate            DateTime       @map("end_date") @db.Date
  status             String         @default("Pending")
  dailyPriceSnapshot Decimal        @map("daily_price_snapshot") @db.Decimal(10, 2)
  depositSnapshot    Decimal        @map("deposit_snapshot") @db.Decimal(10, 2)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  payments           Payment[]
  deposit            Deposit?
  damageReports      DamageReport[]
  reviews            Review[]

  @@map("bookings")
}

model Payment {
  id               String   @id @default(uuid()) @db.Uuid
  bookingId        String   @map("booking_id") @db.Uuid
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentMethod    String   @map("payment_method")
  amount           Decimal  @db.Decimal(10, 2)
  status           String
  gatewayReference String?  @map("gateway_reference")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

model Deposit {
  id               String    @id @default(uuid()) @db.Uuid
  bookingId        String    @unique @map("booking_id") @db.Uuid
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  amount           Decimal   @db.Decimal(10, 2)
  status           String
  deductedAmount   Decimal   @default(0.00) @map("deducted_amount") @db.Decimal(10, 2)
  gatewayReference String?   @map("gateway_reference")
  releasedAt       DateTime? @map("released_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("deposits")
}

model DamageReport {
  id              String   @id @default(uuid()) @db.Uuid
  bookingId       String   @map("booking_id") @db.Uuid
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  ownerId         String   @map("owner_id") @db.Uuid
  owner           User     @relation("OwnerDamageReports", fields: [ownerId], references: [id], onDelete: Restrict)
  renterId        String   @map("renter_id") @db.Uuid
  renter          User     @relation("RenterDamageReports", fields: [renterId], references: [id], onDelete: Restrict)
  description     String
  deductionAmount Decimal  @map("deduction_amount") @db.Decimal(10, 2)
  status          String   @default("Submitted")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("damage_reports")
}

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  bookingId    String   @map("booking_id") @db.Uuid
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewerId   String   @map("reviewer_id") @db.Uuid
  reviewer     User     @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Restrict)
  revieweeId   String   @map("reviewee_id") @db.Uuid
  reviewee     User     @relation("RevieweeReviews", fields: [revieweeId], references: [id], onDelete: Restrict)
  rating       Int
  comment      String?
  reviewerRole String   @map("reviewer_role")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([bookingId, reviewerRole], name: "uq_booking_reviewer_role")
  @@map("reviews")
}

model AdminSetting {
  id           Int      @id @default(autoincrement())
  settingKey   String   @unique @map("setting_key")
  settingValue String   @map("setting_value")
  description  String?
  updatedBy    String?  @map("updated_by") @db.Uuid
  updater      User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@map("admin_settings")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  ipAddress  String?  @map("ip_address")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
